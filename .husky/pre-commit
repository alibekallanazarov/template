# Форматируем и проверяем только индексированные файлы по правилам lint-staged.config.js
# (в конфиге эти параметры задать нельзя).
# --concurrent false: шаблоны выполняются по очереди, иначе tsc, Steiger и Vitest могут прочитать TS-файл,
# пока Prettier из соседнего шаблона его перезаписывает.
# --hide-all: прячем все неиндексированные изменения и неотслеживаемые файлы (по умолчанию — только изменения
# частично индексированных файлов), чтобы tsc, Steiger и Vitest проверяли ровно то, что попадёт в коммит.
# После проверки lint-staged возвращает их на место.
pnpm lint-staged --concurrent false --hide-all
